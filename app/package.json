{
  "name": "schedbuddy",
  "version": "0.3.13",
  "private": true,
  "description": "SchedBuddy 大学生时间管理：桌面(Electron)+局域网Web双端，单用户日程可视化。",
  "main": "desktop/dist/main.cjs",
  "workspaces": [
    "shared",
    "server",
    "web",
    "desktop",
    "mobile"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/engine.test.cjs && node tests/ics.test.cjs",
    "seed:demo": "node tests/seed-demo.cjs",
    "build:shared": "node scripts/build.mjs shared",
    "build:server": "node scripts/build.mjs server",
    "build:desktop": "node scripts/build.mjs desktop",
    "build:web": "npm run build --workspace web",
    "build": "node scripts/build.mjs && npm run build --workspace web",
    "start": "node server/dist/index.cjs",
    "desktop": "node scripts/build.mjs desktop && electron .",
    "dist:dir": "node scripts/build.mjs desktop && electron-builder --dir --win -c electron-builder.yml && node scripts/copy-node.cjs",
    "dev:server": "node scripts/build.mjs server && node --watch server/dist/index.cjs",
    "dev:web": "npm run dev --workspace web",
    "dev:mobile": "npm run start --workspace mobile"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
