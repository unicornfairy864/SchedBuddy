# 依赖与构建产物
node_modules/
dist/
release/
out/
*.log
*.tsbuildinfo
.npm-cache/

# 运行时数据（保留在 app/data，但不入库）：库文件 / WAL / 备份 / 手动导出备份
app/data/*.db
app/data/*.db-journal
app/data/*.db-wal
app/data/*.db-shm
app/data/backups/
app/data/export/

# 桌面打包产物（electron-builder 输出目录）
app/desktop/release/
desktop/release/

# 系统 / 编辑器 / 临时
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.tmp
